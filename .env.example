# Tuneshine device hostname — find it on the label on the back of your device.
# If left empty, the app will attempt to auto-discover via mDNS.
TUNESHINE_HOST=tuneshine-XXXX.local

# ── Web portal (LAN only) ── open http://<pi>.local:8080
PORTAL_PORT=8080
PORTAL_BIND=0.0.0.0

# ── Tram mode ──
# Free key: https://api.golemio.cz/api-keys
GOLEMIO_API_KEY=
# GTFS stop id: U873Z1P = Poštovská platform A, toward Špitálská -> Vysočanská.
# (U873Z2P = platform B, toward Kolbenova.) Empty = query by STOP_NAMES instead.
STOP_IDS=U873Z1P
STOP_NAMES=Poštovská
# Extra filter on platform code. Empty = all platforms.
PLATFORMS=A
DIRECTION_FILTER=
LINES=
MIN_MINUTES=0
ACTIVE_WINDOW=07:00-20:00
TIMEZONE=Europe/Prague
POLL_SECONDS=60
